# Copy to .env and fill in. Never commit .env.
# Frontend (vite dev server) and backend (Spring Boot, context path /api)
BASE_URL=http://localhost:5173
API_URL=http://localhost:8080/api

# An existing FRANCHISOR (admin) account on the TEST database.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# What the outlet logs in with. The login form says "Mobile number or username";
# outlets are created without a username, so this assumes the outlet's mobile number.
# Set to "username" and fix helpers.outletLoginName() if your backend differs.
OUTLET_LOGIN_FIELD=mobile
